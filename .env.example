# ============================================================
# NEXUS — environment template (MASTER SPEC v2, Security layer)
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets. `.env` is gitignored; this file
# contains placeholders only.
#
# Integration API keys (Google, Discord, LinkedIn, Meta, Threads,
# Resend, AI providers, X/Twitter, YouTube, ...) do NOT belong here.
# They are entered in the app's Integrations module and encrypted at
# rest with APP_SECRET (AES-256-GCM) — the in-app credentials vault.

# ── Core / Security ───────────────────────────────────────────────
# Signs auth tokens (HMAC) and encrypts stored integration secrets.
# Use a long random string (32+ chars). REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string

# Admin login. Both MUST be overridden in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated allowed CORS origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000

# Public base URL used in outbound links, emails, and callbacks.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Autopilot persistence (optional) ─────────────────────────────
# MongoDB is used only by lib/autopilot.js; the app runs without it.
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexus

# ── Discord (optional fallback) ──────────────────────────────────
# Normally configured via Integrations UI; env value is a fallback
# for the interactions signature check.
DISCORD_PUBLIC_KEY=

# ── Reserved for planned integrations (not read by code yet) ─────
# Keep these OUT of the repo when they become real; enter live values
# in the Integrations module instead whenever possible.
# GOOGLE_SHEETS_OPERATIONAL_ID=
# GOOGLE_DRIVE_MEDIA_ROOT=
# GOOGLE_SERVICE_ACCOUNT_FILE=
# RESEND_API_KEY=
# X_TWITTER_BEARER_TOKEN=
# YOUTUBE_DATA_API_KEY=